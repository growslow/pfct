# Client configuration: publishable key only; never use a service role key in an app.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=

# Reserved for a future server-side FatSecret integration.
# These must never be included in an iOS/Android bundle.
FATSECRET_CLIENT_ID=
FATSECRET_CLIENT_SECRET=
